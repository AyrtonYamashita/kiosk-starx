# URL da API na VPS (só o servidor do painel usa; o navegador nunca fala direto com a API)
API_URL=http://localhost:3100

# mesmo valor de PANEL_SECRET da API (deploy/.env)
PANEL_SECRET=

# Mapa de fundo da página do dispositivo (estilos vetoriais no esquema OpenMapTiles). Vazio = OpenFreeMap,
# sem chave: escuro https://tiles.openfreemap.org/styles/dark, claro https://tiles.openfreemap.org/styles/positron.
# Para trocar de provedor ou usar tiles próprios na VPS, aponte para o style.json de cada modo.
NEXT_PUBLIC_MAP_STYLE_DARK=
NEXT_PUBLIC_MAP_STYLE_LIGHT=
