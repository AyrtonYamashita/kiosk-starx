<?xml version="1.0" encoding="utf-8"?>
<!-- Janela de diálogo: cartão branco, raio 10, borda 1dp (o design system não usa sombra em cartão; a do modal fica com o sistema) -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="16dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/starx_surface" />
        <corners android:radius="10dp" />
        <stroke android:width="1dp" android:color="@color/starx_line" />
    </shape>
</inset>
