<?xml version="1.0" encoding="utf-8"?>
<!-- Sites internos do modo "site" podem ser HTTP. A comunicação com o painel (fase 2) será HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
