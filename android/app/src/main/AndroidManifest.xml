<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- vibração do aviso de inatividade (permissão normal: concedida na instalação) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- acender a tela na saída por inatividade com a tela apagada -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- área de toque no canto por cima de outros apps (concedida uma vez: tela do Android ou appops por ADB) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- informações do aparelho: serial/IMEI (Device Owner concede a si mesmo) e SSID do Wi-Fi (exige localização) -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- localização para o painel também com outro app na frente (Device Owner concede) -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Android 11+: listar os apps instalados (escolha dos apps do kiosk) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- apps pelo painel: instalação/remoção silenciosas (Device Owner) e "recarregar" no modo app único -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <application
        android:name=".KioskApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Kiosk.Light">

        <receiver
            android:name=".admin.AdminReceiver"
            android:description="@string/admin_description"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".boot.BootReceiver"
            android:exported="true">
            <!-- BOOT_COMPLETED é entregue em fila, um app por vez: a prioridade alta coloca o kiosk no começo -->
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- configuração por ADB: a permissão DUMP só existe para o shell do ADB e o sistema -->
        <receiver
            android:name=".adb.AdbConfigReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.pstarx.kiosk.CONFIG" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".kiosk.KioskController$AdminSessionEnd"
            android:exported="false" />

        <!-- próximo check-in no painel -->
        <receiver
            android:name=".panel.PanelSync$Alarm"
            android:exported="false" />

        <!-- saída por inatividade com a tela apagada (alarme no prazo) -->
        <receiver
            android:name=".kiosk.IdleAlarmReceiver"
            android:exported="false" />

        <!-- resultado do PackageInstaller (instalação/remoção pelo painel) -->
        <receiver
            android:name=".apps.AppInstaller$StatusReceiver"
            android:exported="false" />

        <!-- mensagem enviada pelo painel -->
        <activity
            android:name=".ui.MessageActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Kiosk.Dialog" />

        <!-- aviso de bateria fraca -->
        <activity
            android:name=".ui.LowBatteryActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/Kiosk.Dialog" />

        <!-- ícone na gaveta de apps -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tela do kiosk: launcher padrão enquanto o kiosk está ligado (habilitada e definida como HOME pelo
             KioskController via addPersistentPreferredActivity; desabilitada fora do kiosk). Entra sozinha em lock task. -->
        <activity
            android:name=".kiosk.KioskActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:lockTaskMode="if_whitelisted"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:theme="@style/Kiosk.Screen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.PinActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Kiosk.Dialog"
            android:windowSoftInputMode="stateVisible" />

        <activity
            android:name=".ui.SettingsActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Kiosk.Light"
            android:windowSoftInputMode="adjustResize" />

        <!-- Android 12+: telas exigidas no provisionamento por QR -->
        <activity
            android:name=".admin.GetProvisioningModeActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.app.action.GET_PROVISIONING_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".admin.PolicyComplianceActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
