# Desenvolvimento local (npm run dev). Em produção, veja deploy/.env.example.
DATABASE_URL=postgres://kiosk:kiosk@127.0.0.1:5434/kiosk
PUBLIC_URL=http://localhost:3100
PORT=3100
APK_DIR=data/apks
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha
CHECKIN_INTERVAL_SEC=60
TRUST_PROXY=false

# Fuso da operação (IANA): dias do histórico de cargas e "hoje". Padrão: America/Cuiaba
# TIME_ZONE=America/Cuiaba

# Notificações no celular (Web Push). Gerar com: npx web-push generate-vapid-keys
# A pública também vai para o painel; a privada fica só aqui. Sem as duas, ficam desligadas.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://kiosk.pstarx.com
