# Copie para deploy/.env na VPS e preencha.
# Endereço público da API (o mesmo configurado no Caddy). Vai no QR e nos aparelhos: não troque depois.
PUBLIC_URL=https://api-kiosk.pstarx.com
POSTGRES_PASSWORD=gere-uma-senha-longa
# administrador inicial (criado só se não existir nenhum). Troque a senha no painel e apague esta linha.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=gere-uma-senha-longa
CHECKIN_INTERVAL_SEC=30
# onde a API escuta: 127.0.0.1 (Caddy na mesma máquina) ou o IP interno desta VM (Caddy em outra VM)
API_BIND=127.0.0.1
API_PORT=3100
# painel que pode enviar APKs direto para a API (CORS); separe vários por vírgula
PANEL_ORIGINS=https://kiosk.pstarx.com
# tamanho máximo de um APK no repositório (a Cloudflare no plano grátis aceita até 100 MB por envio)
MAX_APK_MB=95
# atualiza o app do kiosk nos aparelhos quando um APK mais novo é publicado em data/apks
AUTO_UPDATE_APP=true
# sessão do painel: validade máxima (h) e expiração por inatividade (h)
SESSION_TTL_HOURS=48
SESSION_IDLE_HOURS=8
# segredo compartilhado com o painel (Vercel → mesma variável PANEL_SECRET): a API confia no IP/navegador reais que o
# painel repassa (limite e bloqueio por IP, auditoria, lista de sessões). Gere com: openssl rand -base64 32
PANEL_SECRET=

# 2FA (fase 1.3a): código por e-mail. Ligue só depois de gerar os códigos de recuperação (docs/login.md).
AUTH_REQUIRE_2FA=false
# segredo dos HMACs dos códigos e dos navegadores confiáveis (32+ caracteres): openssl rand -base64 48
AUTH_SECRET=
# Resend: a chave só existe aqui (nunca no painel nem no repositório)
RESEND_API_KEY=
MAIL_FROM=StarX Kiosk <no-reply@pstarx.com>
# OTP_TTL_MIN=10
# TRUST_DAYS=30
# Passkeys (fase 1.3c). RP ID não pode mudar depois (invalida as passkeys cadastradas).
WEBAUTHN_RP_ID=pstarx.com
WEBAUTHN_ORIGINS=https://kiosk.pstarx.com

# Leitura do SSW: dias que os eventos brutos ficam guardados (as cargas ficam para sempre) e os sinais de vida.
# OPS_RETENTION_DAYS=90
# OPS_HEARTBEAT_RETENTION_DAYS=7
