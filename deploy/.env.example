# Copie para deploy/.env na VPS e preencha.
# Endereço público da API (o mesmo configurado no Caddy). Vai no QR e nos aparelhos: não troque depois.
PUBLIC_URL=https://kiosk-api.suaempresa.com.br
POSTGRES_PASSWORD=gere-uma-senha-longa
# administrador inicial (criado só se não existir nenhum). Troque a senha no painel e apague esta linha.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=gere-uma-senha-longa
CHECKIN_INTERVAL_SEC=60
# porta local da API (só 127.0.0.1); o Caddy encaminha para ela
API_PORT=3100
